# 辨是非 · 服务端环境变量示例
# 部署到腾讯云 CloudBase 云托管时，把下面的值填到
#   「云托管控制台 → 服务 → 服务配置 → 环境变量」
# 切勿把真实密钥提交进代码仓库。

# ===== AI 模型（OpenAI 兼容网关，必需）=====
# 接口地址：CloudBase AI 网关形如
#   https://<环境ID>.api.tcloudbasegateway.com/v1/ai/cloudbase
# 也可填任意 OpenAI 兼容地址，如 https://api.openai.com/v1
AI_BASE_URL=https://dev-d4g97a4h5772bec4a.api.tcloudbasegateway.com/v1/ai/cloudbase
# 模型 API Key（CloudBase AI 网关的 service_role Key，或第三方 Key）
AI_KEY=
# 模型名：CloudBase AI 网关常用 hy3；第三方填 gpt-3.5-turbo / deepseek-chat 等
AI_MODEL=hy3

# ===== 数据库：云开发数据库（CloudBase Document DB，免连接串）=====
# 云托管（同环境）内一般无需密钥，tcb.init({ env }) 即用；
# 跨环境 / 本地调试可填 secretId + secretKey。
# 文档库集合即用即建，无需建表。推荐索引见 cloudbase/collections.md。
CLOUD_ENV=dev-d4g97a4h5772bec4a
# TCB_SECRETID=
# TCB_SECRETKEY=

# ===== 业务开关（可选）=====
# 每日免费分析次数
FREE_QUOTA=10
# worker 扫描 pending 任务的间隔（毫秒）
WORKER_INTERVAL=5000

# ===== 小程序虚拟支付（打赏，可选）=====
# 前端 config.USE_VIRTUAL_PAY=true 时启用。需先在微信小程序后台开通「虚拟支付」能力
# （类目需符合要求），并在微信支付商户平台「虚拟支付」获取 offerId 与 API 密钥。
# 三项都填后，/api/tip/sign 才会返回签名；否则打赏报「未配置」。
VIRTUAL_PAY_OFFERID=           # 虚拟支付 offerId（商户平台获取）
VIRTUAL_PAY_KEY=               # 虚拟支付 API 密钥（商户平台获取，切勿泄露）
VIRTUAL_PAY_APPID=wxb171dd3c5f5449ef  # 小程序 AppID（默认即本项目 AppID）
VIRTUAL_PAY_COIN_RATIO=1       # 1 元 = 多少币（buyQuantity = round(amount*ratio)）

# ===== 云托管注入（无需手填）=====
# PORT：云托管会自动注入，服务监听该端口；本地默认 80
# VERCEL：部署到 Vercel 时置 1（关闭常驻 worker）
